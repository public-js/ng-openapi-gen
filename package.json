{
  "name": "@public-js/ng-openapi-gen",
  "version": "0.1.1",
  "description": "An OpenAPI 3 code generator for Angular",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-build-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:fixtures": "vitest run test/fixtures",
    "cd:prepare-release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "~11.2.0",
    "@sindresorhus/transliterate": "^1.6.0",
    "change-case": "^5.4.4",
    "eol": "~0.9.0",
    "fs-extra": "^11.0.0",
    "handlebars": "~4.7.0",
    "jsesc": "~3.0.0",
    "openapi3-ts": "~2.0.0",
    "yargs-parser": "^21.1.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/jsesc": "~3.0.0",
    "@types/node": "^22.13.4",
    "conventional-changelog-cli": "^5.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2",
    "vitest": "^2.1.8"
  },
  "bin": {
    "ng-openapi-gen": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "author": "Public JS <public-js@muffin.blue> (https://github.com/public-js/public-js)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/public-js/ng-openapi-gen.git"
  },
  "homepage": "https://github.com/public-js/ng-openapi-gen",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module"
}
