{
  "name": "@public-js/ng-openapi-gen",
  "version": "0.2.0",
  "description": "An OpenAPI 3 code generator for Angular",
  "scripts": {
    "build": "npm run generate:schema && tsc -p tsconfig.build.json && node scripts/copy-build-assets.mjs",
    "generate:schema": "node --import tsx ./scripts/generate-schema.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:fixtures": "vitest run test/fixtures",
    "cd:prepare-release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^16.0.5",
    "@sindresorhus/transliterate": "^1.6.0",
    "change-case": "^5.4.4",
    "jsesc": "~3.0.0",
    "openapi3-ts": "^4.6.2",
    "ts-morph": "^27.0.2",
    "yargs-parser": "^21.1.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/jsesc": "~3.0.0",
    "@types/node": "^22.13.4",
    "conventional-changelog": "^8.1.0",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "prettier": "^3.9.10",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2",
    "vitest": "^5.1.0"
  },
  "bin": {
    "ng-openapi-gen": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "author": "Public JS <public-js@muffin.blue> (https://github.com/public-js/public-js)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/public-js/ng-openapi-gen.git"
  },
  "homepage": "https://github.com/public-js/ng-openapi-gen",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "module"
}
